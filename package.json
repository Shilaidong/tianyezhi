{
  "name": "tianyezhi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "tsx scripts/cf-run.ts npx opennextjs-cloudflare build && tsx scripts/cf-run.ts npx opennextjs-cloudflare preview",
    "deploy": "tsx scripts/cf-run.ts npx opennextjs-cloudflare build && tsx scripts/cf-run.ts npx wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply tianyezhi --local",
    "db:migrate:remote": "tsx scripts/cf-run.ts npx wrangler d1 migrations apply tianyezhi --remote",
    "db:seed:local": "tsx scripts/seed.ts --local",
    "db:seed:remote": "tsx scripts/cf-run.ts npx tsx scripts/seed.ts --remote",
    "tyz": "tsx scripts/tyz.ts",
    "r2:upload:local": "tsx scripts/upload-images.ts",
    "r2:upload:remote": "tsx scripts/cf-run.ts npx tsx scripts/upload-images.ts --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "gray-matter": "^4.0.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "workerd@1.20260811.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
